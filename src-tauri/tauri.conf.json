{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Droothe Download Manager",
  "version": "0.1.0",
  "identifier": "dev.droothe.ddm",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev:tauri",
      "cwd": ".."
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build:tauri",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Droothe Download Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ddm"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}

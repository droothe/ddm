{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the DDM desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "clipboard-manager:allow-read-text",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "deep-link:default",
    "notification:default"
  ]
}

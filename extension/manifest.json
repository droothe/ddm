{
  "manifest_version": 3,
  "name": "Download with DDM",
  "version": "1.0.0",
  "description": "Send a link to an open Droothe Download Manager tab.",
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
